rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each profile only reaches its own document.
    // Creating a document needs the id of an existing invite. The invites have
    // no rule, so the app can neither read nor list them.
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.inviteCode is string
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode));
    }
  }
}
